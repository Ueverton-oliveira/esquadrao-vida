<main>
  <header>
    <h1>Salas de Atendimento</h1>

    <%= link_to "Nova sala", new_admin_room_path %>
  </header>

  <section>
    <% if @rooms.any? %>
      <% @rooms.each do |room| %>
        <article>
          <h2><%= room.name %></h2>

          <p>
            Status:
            <%= room.active? ? "Ativa" : "Inativa" %>
          </p>

          <p>
            Google Meet:
            <%= link_to room.meeting_url,
                        room.meeting_url,
                        target: "_blank",
                        rel: "noopener" %>
          </p>

          <%= link_to "Editar",
                      edit_admin_room_path(room) %>
        </article>
      <% end %>
    <% else %>
      <p>Nenhuma sala cadastrada.</p>
    <% end %>
  </section>
</main>
